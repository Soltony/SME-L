# SME Lending — environment template.
# Copy to .env and fill in. Never commit .env.
# Names used by the previous SME deployment are accepted where noted, so an
# existing .env keeps working.

# ---------------------------------------------------------------------------
# Database (SQL Server)
# ---------------------------------------------------------------------------
DATABASE_URL="sqlserver://localhost;database=SME_L;user=prisma_user;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"

# ---------------------------------------------------------------------------
# Secrets. Missing, short or placeholder values are refused (fail closed).
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
# Signs staff and borrower sessions. At least 32 characters.
SESSION_SECRET=
# Required header x-cron-secret for POST /api/cron/tick. At least 24
# characters. Unset = the endpoint refuses every call.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# The public origin(s), comma-separated. The first one is used for CORS and
# must be https (or localhost). Every origin listed is trusted for POSTs.
ALLOWED_ORIGIN="https://lending.example.et"
# true only behind a reverse proxy you control that sets X-Forwarded-For,
# X-Forwarded-Host and X-Forwarded-Proto. Rate limits key on the client address.
TRUST_PROXY=false
# Who may frame the app. Empty = nobody (recommended).
FRAME_ANCESTORS=

# Staff sessions: idle minutes (5–240), absolute hours (1–72).
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
# Borrower sessions: idle minutes (5–240), absolute hours (1–24).
BORROWER_IDLE_MINUTES=30
BORROWER_SESSION_HOURS=8

# ---------------------------------------------------------------------------
# Business calendar
# ---------------------------------------------------------------------------
# Minutes east of UTC that define "a day" for interest, due dates and arrears.
# 180 = East Africa Time. Changing this on a live book moves day boundaries.
BUSINESS_UTC_OFFSET_MINUTES=180

# ---------------------------------------------------------------------------
# Super-app: borrower sign-in and wallet payments
# ---------------------------------------------------------------------------
TOKEN_VALIDATION_API_URL=
# SME name also accepted: NIB_PAYMENT_URL
PAYMENT_URL=
# SME name also accepted: NIB_PAYMENT_KEY
PAYMENT_KEY=
ACCOUNT_NO=
COMPANY_NAME=
# The URL the gateway calls back. /api/payment/callback is preferred;
# /api/payment-callback (the path SME registered) also works.
CALLBACK_URL="https://lending.example.et/api/payment/callback"
# Unset = strict: a callback whose signature does not verify is refused.
# Set to false only while confirming a live gateway's signature format; the
# staff console shows a warning banner for as long as it is set.
PAYMENT_CALLBACK_STRICT=
# JavaScript channel the super-app web view exposes. Default myJsChannel;
# MyJsChannel is also tried.
NEXT_PUBLIC_SUPERAPP_CHANNEL=

# ---------------------------------------------------------------------------
# Core banking: account lookup and disbursement
# ---------------------------------------------------------------------------
# SME name also accepted: EXTERNAL_API_URL
CBS_ACCOUNTS_URL=
# SME name also accepted: EXTERNAL_DISBURSEMENT_URL
CBS_DISBURSEMENT_URL=
# SME names also accepted: EXTERNAL_API_USERNAME / EXTERNAL_API_PASSWORD.
# There is no built-in fallback credential.
CBS_API_USERNAME=
CBS_API_PASSWORD=
# "local" sends phone numbers as 09XXXXXXXX; the default sends 2519XXXXXXXX.
CBS_PHONE_FORMAT=

# ---------------------------------------------------------------------------
# SMS: receipts, reminders, staff one-time passwords
# ---------------------------------------------------------------------------
# SME name also accepted: SMS_URL. Unset = messages are logged as not sent.
SMS_API_URL=
# Optional. Sent as a Bearer token.
SMS_API_KEY=

# ---------------------------------------------------------------------------
# Storage and worker
# ---------------------------------------------------------------------------
# Borrower documents. Default ./storage/documents. Must not be web-served.
DOCUMENTS_DIR=
# Seconds between passes of `npm run run:worker` (15–3600).
WORKER_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# First administrator, created by `npm run db:seed`.
# Leave the password empty to have a one-time password generated and printed
# once. Either way the account must set its own password at first sign-in.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@sme-lending.local
SEED_ADMIN_PHONE=0911000000
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# DEVELOPMENT ONLY. Each is ignored when NODE_ENV=production.
# ---------------------------------------------------------------------------
# Phone-number sign-in on /connect without a super-app token.
ALLOW_TEST_LOGIN=false
# Sample accounts and always-successful disbursements; no bank involved.
CBS_SIMULATE=false
# Pin "today" (YYYY-MM-DD) to test accrual, due dates and arrears.
BUSINESS_DATE_OVERRIDE=
